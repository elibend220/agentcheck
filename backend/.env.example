# JARVIS AGI Backend Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Logging
LOG_LEVEL=INFO

# LLM Configuration (for production)
# Uncomment and configure for real LLM integration
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk_...
# OPENAI_MODEL=gpt-4

# OR for Claude API
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk_...
# ANTHROPIC_MODEL=claude-opus

# Database (optional)
# DATABASE_URL=postgresql://user:password@localhost/jarvis

# Authentication (optional)
# ENABLE_AUTH=true
# SECRET_KEY=your-secret-key-here

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=1000

# Phase Configuration (default all enabled)
ENABLE_PHASE4=false
ENABLE_PHASE5=false
ENABLE_PHASE6=true
ENABLE_PHASE7=true
ENABLE_PHASE8=true
ENABLE_PHASE9=true
ENABLE_PHASE10=true
ENABLE_PHASE11=true
ENABLE_PHASE12=true
ENABLE_PHASE13=true
ENABLE_PHASE14=false
ENABLE_PHASE15=true
ENABLE_PHASE21=false
ENABLE_PHASE16=true
ENABLE_PHASE17=true
ENABLE_PHASE18=true
ENABLE_PHASE19=true
ENABLE_PHASE20=true
ENABLE_PHASE22=true
ENABLE_PHASE23=true

# Debug Mode
DEBUG=false
